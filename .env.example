# Database
POSTGRES_USER=blockmesh
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=blockmesh

# Blockchain RPC (Sepolia defaults — swap for Mainnet if desired)
RPC_ENDPOINT_1=https://ethereum-sepolia-rpc.publicnode.com
RPC_ENDPOINT_2=https://rpc.sepolia.org

# Admin API protection (optional — leave blank for local dev)
ADMIN_SECRET=

# Domain & TLS
DOMAIN=blockmesh.yourdomain.com
ACME_EMAIL=your-email@example.com
